{
  "name": "@recpm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-type": "./src/app-type.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "@node-rs/argon2": "^2.2.2",
    "@recpm/db": "workspace:*",
    "@recpm/shared": "workspace:*",
    "better-auth": "^1.7.28",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.22",
    "ioredis": "^6.1.0",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "resend": "^6.40.1",
    "uuidv7": "1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@recpm/config": "workspace:*",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  }
}
