{
  "name": "@recpm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-type": "./src/app-type.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "@node-rs/argon2": "^2.2.2",
    "@recpm/core": "workspace:*",
    "@recpm/db": "workspace:*",
    "@recpm/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.26",
    "@sentry/node": "^10.78.0",
    "better-auth": "^1.7.28",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fflate": "0.8.2",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.22",
    "ioredis": "^6.1.0",
    "nodemailer": "^10.6.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "resend": "^6.40.1",
    "stripe": "23.2.0",
    "uuidv7": "1.2.1",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@recpm/config": "workspace:*",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "3.6.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  }
}
