# Copie para infra/prod/.env na VPS (chmod 600). Nunca faça commit deste arquivo preenchido.
# Gere senhas com: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# ── Domínio (site em SITE_DOMAIN, app em app.SITE_DOMAIN; os dois DNS apontando para a VPS) ──
SITE_DOMAIN=recpm.com.br
ACME_EMAIL=ops@recpm.com.br

# ── Banco ──
POSTGRES_PASSWORD=
RECPM_OWNER_PASSWORD=
RECPM_APP_PASSWORD=
RECPM_AUTH_PASSWORD=
RECPM_PLATFORM_PASSWORD=

# ── Segredos da aplicação ──
BETTER_AUTH_SECRET=
# 32 bytes em base64: openssl rand -base64 32
SECRETS_KEY=

# ── Arquivos (Cloudflare R2 ou outro S3) ──
S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=recpm-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── E-mail (Resend) ──
RESEND_API_KEY=
EMAIL_FROM="Rec PM <nao-responda@recpm.com.br>"

# ── Cobrança ──
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# ── Push (npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@recpm.com.br

# ── Login com Google (opcional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── IA padrão da plataforma (opcional) ──
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── Observabilidade (Sentry; vazio = desligado) ──
SENTRY_DSN=
# DSN do projeto do front (vai para o build da imagem web)
VITE_SENTRY_DSN=

# ── Backup fora da VPS (S3 compatível; vazio = só cópia local em infra/prod/backups) ──
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=14

# ── Antivírus (docker compose --profile antivirus up -d clamav) ──
CLAMAV_HOST=
