# Copie para .env na raiz. Valores abaixo batem com infra/docker-compose.yml.

# ── Banco (um usuário por papel; ver infra/postgres/init/01-roles.sql) ──
DATABASE_URL_OWNER=postgres://recpm_owner:recpm_owner@localhost:5432/recpm
DATABASE_URL_APP=postgres://recpm_app:recpm_app@localhost:5432/recpm
DATABASE_URL_AUTH=postgres://recpm_auth:recpm_auth@localhost:5432/recpm
DATABASE_URL_PLATFORM=postgres://recpm_platform:recpm_platform@localhost:5432/recpm

# ── Valkey (sessões em cache, rate limit, pub/sub) ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
# gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-de-32-bytes-ou-mais
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Criptografia de segredos do tenant (AES-256-GCM, 32 bytes em base64) ──
ENCRYPTION_KEY=

# ── E-mail: com RESEND_API_KEY usa Resend; sem ela, envia para o Mailpit local ──
RESEND_API_KEY=
EMAIL_FROM="Rec PM <nao-responda@localhost>"
SMTP_URL=smtp://localhost:1025

# ── Cobrança SaaS (sem chaves: trial e plano gratuito funcionam; checkout responde 503) ──
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# ── Web push (sem chaves: o push fica desligado; o sino e o e-mail continuam) ──
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seudominio.com.br

# ── Assistente de IA (provedor compatível com a API da OpenAI). Cada workspace pode usar a própria chave. ──
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
