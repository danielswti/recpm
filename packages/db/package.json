{
  "name": "@recpm/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./tenant-context": "./src/tenant-context.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./src/seed/index.ts",
    "./testing": "./src/testing/test-db.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "test": "vitest run",
    "grant-super-admin": "tsx --env-file-if-exists=../../.env src/scripts/grant-super-admin.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@recpm/config": "workspace:*",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.1.2"
  }
}
